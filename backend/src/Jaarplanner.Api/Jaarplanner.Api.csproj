<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Enables `dotnet user-secrets` for local dev secrets (DB connection string). -->
    <!-- No secret is stored here; the id only points at a per-user store (Art. VI.4 / ADR-0012). -->
    <UserSecretsId>jaarplanner-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
    <!-- Transitive pin, NOT a direct dependency (E7-12). Microsoft.AspNetCore.OpenApi still -->
    <!-- resolves Microsoft.OpenApi 2.0.0 — true as of 10.0.10, so bumping it does not help — -->
    <!-- and 2.0.0 carries GHSA-v5pm-xwqc-g5wc / CVE-2026-49451 (high: uncontrolled recursion -->
    <!-- on circular schema refs → stack overflow). Advisory patches 2.x at 2.7.5; pinned to -->
    <!-- the latest 2.x. Do NOT move to 3.x while the framework package asks for 2.x. -->
    <!-- Remove this pin once Microsoft.AspNetCore.OpenApi depends on >= 2.7.5 itself. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <!-- Cloud secrets binding (E0-07 / ADR-0012): adds Azure Key Vault as a configuration -->
    <!-- source ONLY when a vault URI is configured (no-op locally + in tests — Art. VI.4). -->
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <!-- EF Core design-time tooling (migrations). PrivateAssets=all keeps it dev-only -->
    <!-- and out of the published app; `dotnet ef` uses the Api as the startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jaarplanner.Application\Jaarplanner.Application.csproj" />
    <ProjectReference Include="..\Jaarplanner.Infrastructure\Jaarplanner.Infrastructure.csproj" />
  </ItemGroup>

</Project>
