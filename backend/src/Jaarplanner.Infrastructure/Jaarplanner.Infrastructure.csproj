<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Jaarplanner.Application\Jaarplanner.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core + Npgsql provider (transitively brings Microsoft.EntityFrameworkCore 10). -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <!-- DbContext readiness health check (AddDbContextCheck) — first-party, no Xabaril dependency. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.9" />
    <!-- Configuration + DI abstractions for the AddInfrastructure extension method. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <!-- Options-pattern config binding (services.Configure<T>(section)) for the AzureAI options
         seam (E2-01); also brings IOptions<T>. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
    <!-- Typed HttpClient factory (AddHttpClient<IAiClient, AzureAiFoundryClient>) for the Azure AI
         Foundry client (E2-01). -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
