<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Jaarplanner.Application\Jaarplanner.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- So a unit test can assert that a hand-written table-name constant still matches the EF mapping it mirrors
         (EfJaarplanOpslag.ParametersTabel). Exposing the constant publicly would put a persistence detail on the
         port's surface; the alternative, leaving the two literals unbound, is what the E3-04 audit objected to. -->
    <InternalsVisibleTo Include="Jaarplanner.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Excel parsing for the Op.stap import (Art. VIII — ClosedXML/MIT; EPPlus is forbidden). -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <!-- Keeps the Data Protection keys that encrypt the session cookie in this database (E6-01, ADR-0031), so a
         restart or a second instance does not log everyone out. Pinned to 10.0.9 to match EF Core's line here. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.9" />
    <!-- EF Core + Npgsql provider (transitively brings Microsoft.EntityFrameworkCore 10). -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <!-- DbContext readiness health check (AddDbContextCheck) — first-party, no Xabaril dependency. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.9" />
    <!-- Configuration + DI abstractions for the AddInfrastructure extension method. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <!-- Options-pattern config binding (services.Configure<T>(section)) for the E1-06 data-driven
         discipline-selection seam (Art. XIV) and the E2-01 AzureAI options seam; brings IOptions<T>. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
    <!-- Typed HttpClient factory (AddHttpClient<IAiClient, AzureAiFoundryClient>) for the Azure AI
         Foundry client (E2-01). -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <!-- Microsoft Entra sign-in for the AI client when no key is configured (TB-004): a managed identity in Azure,
         `az login` on a developer's machine. The same version the Api already uses for Key Vault. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <!-- Transitive pin, NOT a direct dependency (E7-12 practice, E6-01). Data Protection above resolves 10.0.9, which
         carries five high-severity advisories (GHSA-23rf-6693-g89p, -8q5v-6pqq-x66h, -cvvh-rhrc-wg4q, -g8r8-53c2-pm3f
         and -mmjf-rqrv-855v); `dotnet list package vulnerable` is clean at 10.0.12. Remove this pin once Data
         Protection itself depends on a patched version.
         THE PIN DOES NOT REACH THE RUNNING API: the Api is a web project, so it loads this assembly from the ASP.NET
         Core shared framework, not from this package. What protects the deployed app is the runtime patch level:
         10.0.10 or later, the first patched release per the GitHub advisory database. E7-11 carries it as a
         deployment requirement. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
